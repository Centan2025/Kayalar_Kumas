# Marketplace Integration — Environment Variables
# Copy this file to .env.local and fill in your credentials

NODE_ENV=development

# ── Trendyol ──────────────────────────────────
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# ── Hepsiburada ───────────────────────────────
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_API_KEY=

# ── N11 ───────────────────────────────────────
N11_APP_KEY=
N11_APP_SECRET=

# ── Amazon Marketplace ────────────────────────
AMAZON_SELLER_ID=
AMAZON_MWS_AUTH_TOKEN=

# ── ÇiçekSepeti ──────────────────────────────
CICEKSEPETI_API_KEY=

# ── App Settings ──────────────────────────────
SYNC_INTERVAL_MS=300000
RETRY_ATTEMPTS=3
BATCH_SIZE=50
